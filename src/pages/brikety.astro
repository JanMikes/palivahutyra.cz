---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';

---

<BaseLayout
  title="Brikety a pelety Biomac | Paliva Hutyra"
  description="Oficiální partner Biomac. Prodej dřevěných briket a pelet ve Frýdku-Místku. Ekologické topení s maximální účinností. Platba kartou."
>
  <Header currentPage="/brikety" />

  <Hero
    title="Brikety a pelety"
    subtitle="Ekologické topení s maximální účinností"
    showPhone={false}
    backgroundImage="/images/foto/obr13.jpg"
    small={true}
  />

  <main id="main-content" class="section-padding bg-cream">
    <div class="container-narrow mx-auto">
      <!-- Partner Badge -->
      <div class="text-center mb-12">
        <div class="inline-flex flex-col items-center gap-4 bg-white rounded-2xl shadow-lg p-8">
          <img src="/images/biomac.jpg" alt="Biomac" class="h-20 object-contain" />
          <div>
            <p class="text-xl font-heading font-semibold text-charcoal mb-1">Oficiální partner a prodejce</p>
            <p class="text-charcoal/70">Kompletní sortiment dřevěných briket a pelet</p>
          </div>
        </div>
      </div>

      <!-- Product Links -->
      <div class="bg-forest text-white rounded-2xl p-8 md:p-12 mb-12">
        <div class="text-center mb-8">
          <h2 class="text-2xl md:text-3xl font-heading font-semibold mb-4">Sortiment Biomac</h2>
          <p class="text-white/80 max-w-2xl mx-auto">
            Pro kompletní přehled produktů, aktuální ceník a detailní specifikace navštivte oficiální e-shop Biomac
            nebo nás kontaktujte a rádi vám poradíme.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://eshop.biomac.cz/drevene-brikety-c293672683831300"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-4 bg-white text-forest font-semibold rounded-lg hover:bg-cream transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
            Dřevěné brikety
          </a>
          <a
            href="https://www.biomac.cz/f-m"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-4 bg-white/10 text-white font-semibold rounded-lg hover:bg-white/20 transition-colors border border-white/30"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            Naše prodejna na Biomac.cz
          </a>
        </div>
      </div>

      <!-- Benefits Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        <div class="bg-ash rounded-lg p-6">
          <div class="w-12 h-12 bg-forest/10 rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-forest" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3v18"></path>
              <path d="M3 12h18"></path>
              <rect x="8" y="8" width="8" height="8" rx="2"></rect>
            </svg>
          </div>
          <h3 class="font-semibold text-charcoal mb-2">Vysoká výhřevnost</h3>
          <p class="text-charcoal/70 text-sm">Brikety a pelety mají vyšší výhřevnost než klasické dřevo díky nízkému obsahu vody.</p>
        </div>

        <div class="bg-ash rounded-lg p-6">
          <div class="w-12 h-12 bg-forest/10 rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-forest" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          </div>
          <h3 class="font-semibold text-charcoal mb-2">Ekologické</h3>
          <p class="text-charcoal/70 text-sm">Vyrobené z přírodních materiálů bez chemických pojiv. Šetrné k životnímu prostředí.</p>
        </div>

        <div class="bg-ash rounded-lg p-6">
          <div class="w-12 h-12 bg-forest/10 rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-forest" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <h3 class="font-semibold text-charcoal mb-2">Snadná manipulace</h3>
          <p class="text-charcoal/70 text-sm">Kompaktní balení, čisté skladování a jednoduché dávkování do kotle.</p>
        </div>

        <div class="bg-ash rounded-lg p-6">
          <div class="w-12 h-12 bg-forest/10 rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-forest" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v20"></path>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <h3 class="font-semibold text-charcoal mb-2">Úsporné topení</h3>
          <p class="text-charcoal/70 text-sm">Vysoká účinnost spalování znamená nižší spotřebu a úsporu nákladů.</p>
        </div>

        <div class="bg-ash rounded-lg p-6">
          <div class="w-12 h-12 bg-forest/10 rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-forest" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </div>
          <h3 class="font-semibold text-charcoal mb-2">Minimální popel</h3>
          <p class="text-charcoal/70 text-sm">Čisté spalování s minimem zbytkového popela. Méně čištění kotle.</p>
        </div>

        <div class="bg-ash rounded-lg p-6">
          <div class="w-12 h-12 bg-forest/10 rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-forest" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
              <line x1="1" y1="10" x2="23" y2="10"></line>
            </svg>
          </div>
          <h3 class="font-semibold text-charcoal mb-2">Platba kartou</h3>
          <p class="text-charcoal/70 text-sm">U produktů Biomac přijímáme platbu platební kartou přímo na prodejně.</p>
        </div>
      </div>

      <!-- Contact CTA -->
      <div class="mt-12 text-center">
        <p class="text-charcoal/70 mb-4">Potřebujete poradit s výběrem paliva?</p>
        <a href="tel:+420733708172" class="btn-primary text-lg px-8 py-4">
          Zavolejte nám: 733 708 172
        </a>
      </div>
    </div>
  </main>

  <ContactSection />
  <Footer />

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": "Dřevěné brikety a pelety Biomac",
      "description": "Prémiové dřevěné brikety a pelety od Biomac. Ekologické topení s vysokou výhřevností, minimálním popelem a snadnou manipulací. Oficiální partner Biomac.",
      "brand": {
        "@type": "Brand",
        "name": "Biomac"
      },
      "image": "https://palivahutyra.cz/images/foto/obr6.jpg",
      "offers": {
        "@type": "Offer",
        "url": "https://palivahutyra.cz/brikety",
        "availability": "https://schema.org/InStock",
        "seller": {
          "@type": "Organization",
          "name": "Paliva Hutyra s.r.o."
        }
      }
    }
  </script>
</BaseLayout>

---

<section class="bg-white py-8 md:py-12 border-y border-gray-100">
  <div class="container-narrow mx-auto px-4">
    <!-- Partner logos & features -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 items-center justify-items-center">
      <!-- Biomac Partner -->
      <div class="flex flex-col items-center gap-2">
        <img src="/images/biomac.jpg" alt="Biomac - oficiální partner" class="h-12 md:h-16 object-contain" />
        <span class="text-xs md:text-sm text-charcoal/70 text-center">Oficiální partner</span>
      </div>

      <!-- SD Bílina -->
      <div class="flex flex-col items-center gap-2">
        <img src="/images/znamka.jpg" alt="SD Bílínské uhlí" class="h-12 md:h-16 object-contain" />
        <span class="text-xs md:text-sm text-charcoal/70 text-center">Dodavatel SD Bílina</span>
      </div>

      <!-- Vlastní doprava -->
      <div class="flex flex-col items-center gap-2">
        <div class="w-12 h-12 md:w-16 md:h-16 flex items-center justify-center text-forest">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 md:w-12 md:h-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
        </div>
        <span class="text-xs md:text-sm text-charcoal/70 text-center">Vlastní doprava</span>
      </div>

      <!-- Rodinná firma -->
      <div class="flex flex-col items-center gap-2">
        <div class="w-12 h-12 md:w-16 md:h-16 flex items-center justify-center text-forest">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 md:w-12 md:h-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
        </div>
        <span class="text-xs md:text-sm text-charcoal/70 text-center">Rodinná firma</span>
      </div>
    </div>
  </div>
</section>

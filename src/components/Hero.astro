---
interface Props {
  title?: string;
  subtitle?: string;
  showPhone?: boolean;
  backgroundImage?: string;
  small?: boolean;
}

const {
  title = "Teplo domova začíná u nás",
  subtitle = "Kvalitní dřevo, uhlí a brikety s osobním přístupem a vlastní dopravou",
  showPhone = true,
  backgroundImage = "/images/foto/obr5.jpg",
  small = false
} = Astro.props;
---

<section
  class={`relative ${small ? 'pt-32 pb-16 md:pt-40 md:pb-20' : 'min-h-screen pt-20'} flex items-center justify-center overflow-hidden`}
  style={`background-image: url('${backgroundImage}'); background-size: cover; background-position: center;`}
>
  <!-- Dark overlay -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/60 to-black/70"></div>

  <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
    <!-- Logo -->
    {!small && (
      <div class="mb-6">
        <span class="text-4xl md:text-5xl font-logo">
          <span class="text-amber">paliva</span><span class="text-white">hutyra</span>
        </span>
      </div>
    )}

    <!-- Main heading -->
    <h1 class={`${small ? 'text-3xl md:text-4xl' : 'text-4xl md:text-6xl'} font-heading font-semibold text-white mb-6 text-shadow-lg`}>
      {title}
    </h1>

    <!-- Subtitle -->
    <p class={`${small ? 'text-lg md:text-xl' : 'text-xl md:text-2xl'} text-white/90 mb-8 text-shadow max-w-2xl mx-auto`}>
      {subtitle}
    </p>

    <!-- Phone number -->
    {showPhone && (
      <div class="mb-8">
        <a
          href="tel:+420733708172"
          class="inline-flex items-center gap-3 px-8 py-4 bg-white/10 backdrop-blur-sm border-2 border-white rounded-xl text-white text-2xl md:text-3xl font-bold hover:bg-white/20 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          733 708 172
        </a>
      </div>
    )}

    <!-- CTA Button -->
    {!small && (
      <a href="/cenik" class="btn-primary text-lg px-8 py-4">
        Zobrazit ceník
      </a>
    )}

    <!-- Reviews badges -->
    {!small && (
      <div class="flex flex-wrap justify-center gap-3 mt-8">
        <!-- Google Rating -->
        <a
          href="https://www.google.com/search?q=Paliva+Hutyra+s.r.o+Recenze"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur-sm border border-white/30 rounded-full hover:bg-white/20 transition-colors"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          <div class="flex items-center gap-1.5">
            <span class="font-semibold text-white">4.7</span>
            <div class="flex">
              {[1,2,3,4].map(() => (
                <svg class="w-4 h-4 text-amber" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
              <!-- Half star -->
              <div class="relative w-4 h-4">
                <svg class="absolute w-4 h-4 text-amber/30" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                <div class="absolute overflow-hidden w-1/2 h-4">
                  <svg class="w-4 h-4 text-amber" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                </div>
              </div>
            </div>
          </div>
          <span class="text-sm text-white/70">Google</span>
        </a>

        <!-- Seznam Rating -->
        <a
          href="https://www.firmy.cz/detail/12702799-paliva-hutyra-frydek-mistek-frydek.html"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur-sm border border-white/30 rounded-full hover:bg-white/20 transition-colors"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="12" r="11" fill="#C00"/>
            <path d="M7.5 8.5h9v2h-9zM7.5 13.5h9v2h-9z" fill="#fff"/>
          </svg>
          <div class="flex items-center gap-1.5">
            <span class="font-semibold text-white">4.9</span>
            <div class="flex">
              {[1,2,3,4,5].map(() => (
                <svg class="w-4 h-4 text-amber" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
          </div>
          <span class="text-sm text-white/70">Firmy.cz</span>
        </a>
      </div>
    )}
  </div>

  <!-- Scroll indicator -->
  {!small && (
    <div class="absolute bottom-8 inset-x-0 flex justify-center animate-bounce z-10">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 5v14M5 12l7 7 7-7" />
      </svg>
    </div>
  )}
</section>

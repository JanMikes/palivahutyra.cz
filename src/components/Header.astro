---
interface Props {
  currentPage?: string;
}

const { currentPage = '' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Úvod' },
  { href: '/cenik', label: 'Ceník' },
  { href: '/drevo', label: 'Dřevo' },
  { href: '/uhli', label: 'Uhlí' },
  { href: '/brikety', label: 'Brikety a pelety' }
];
---

<!-- Skip to content link for keyboard navigation -->
<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:bg-forest focus:text-white focus:px-4 focus:py-2 focus:rounded-lg">
  Přeskočit na obsah
</a>

<!-- Closure announcement banner -->
<div id="announcement-bar" class="hidden fixed top-0 left-0 right-0 z-50 bg-ember text-white text-center py-2 px-4 text-sm md:text-base font-medium">
  <span class="inline-flex items-center gap-1.5">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="8" x2="12" y2="12"></line>
      <line x1="12" y1="16" x2="12.01" y2="16"></line>
    </svg>
    <span>Zavřeno: 3.&nbsp;4. a&nbsp;6.&nbsp;4. (Velikonoce)</span>
  </span>
</div>

<header id="header" class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm transition-shadow duration-300">
  <div class="container-narrow mx-auto">
    <div class="flex items-center justify-between h-16 md:h-20 px-4">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2">
        <div class="flex items-center">
          <span class="text-2xl md:text-3xl font-logo">
            <span class="text-ember">Paliva</span><span class="text-forest">Hutyra</span>
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-8" role="navigation" aria-label="Hlavní navigace">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={`text-charcoal hover:text-fire transition-colors font-medium ${currentPage === link.href ? 'text-fire' : ''}`}
            aria-current={currentPage === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Phone Button (Desktop) -->
      <a href="tel:+420733708172" class="hidden md:flex btn-primary gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        733 708 172
      </a>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-btn" class="md:hidden p-2 text-charcoal" aria-label="Otevřít menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="md:hidden hidden bg-white border-t">
    <nav class="flex flex-col py-4" role="navigation" aria-label="Mobilní navigace">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`px-4 py-3 text-charcoal hover:bg-ash hover:text-fire transition-colors ${currentPage === link.href ? 'text-fire bg-ash' : ''}`}
          aria-current={currentPage === link.href ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <a href="tel:+420733708172" class="mx-4 mt-4 btn-primary justify-center">
        Zavolat: 733 708 172
      </a>
    </nav>
  </div>
</header>

<!-- Mobile Floating Call Button -->
<a
  href="tel:+420733708172"
  class="md:hidden fixed bottom-4 right-4 z-50 bg-fire text-white p-4 rounded-full shadow-lg hover:bg-fire-dark transition-colors"
  aria-label="Zavolat na 733 708 172"
>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
  </svg>
</a>

<script>
  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
    menuBtn.setAttribute('aria-expanded', (!isExpanded).toString());
    menuBtn.setAttribute('aria-label', isExpanded ? 'Otevřít menu' : 'Zavřít menu');
    mobileMenu?.classList.toggle('hidden');
  });

  // Header shadow on scroll
  const header = document.getElementById('header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 10) {
      header?.classList.add('shadow-md');
    } else {
      header?.classList.remove('shadow-md');
    }
  });
</script>

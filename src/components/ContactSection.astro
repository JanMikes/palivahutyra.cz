---

---

<section id="kontakt" class="section-padding bg-forest text-white">
  <div class="container-narrow mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-heading font-semibold mb-4 text-white">Kontaktujte nás</h2>
      <p class="text-cream/90 text-lg">Rádi vám poradíme s výběrem</p>
    </div>

    <div class="max-w-2xl mx-auto">
      <div class="grid sm:grid-cols-2 gap-8">
        <!-- Phone -->
        <div class="text-center sm:text-left">
          <h3 class="text-lg font-semibold mb-3 text-amber">Telefon</h3>
          <a
            href="tel:+420733708172"
            class="inline-flex items-center gap-3 text-2xl md:text-3xl font-bold text-white hover:text-amber transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            733 708 172
          </a>
        </div>

        <!-- Email -->
        <div class="text-center sm:text-left">
          <h3 class="text-lg font-semibold mb-3 text-amber">E-mail</h3>
          <a
            href="mailto:info@palivahutyra.cz"
            class="inline-flex items-center gap-3 text-xl text-white hover:text-amber transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            info@palivahutyra.cz
          </a>
        </div>

        <!-- Address -->
        <div class="text-center sm:text-left">
          <h3 class="text-lg font-semibold mb-3 text-amber">Provozovna</h3>
          <a
            href="https://maps.google.com/?q=49.69367316925427,18.386314789494467"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-start gap-3 text-lg text-white hover:text-amber transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 flex-shrink-0 mt-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>
              <strong>Pánské Nové Dvory 2458</strong><br />
              738 01 Frýdek-Místek
            </span>
          </a>
          <p class="text-cream/50 text-sm mt-2">Sídlo společnosti: J. Švermy 486</p>
        </div>

        <!-- Opening Hours -->
        <div class="text-center sm:text-left">
          <h3 class="text-lg font-semibold mb-3 text-amber">Otevírací doba</h3>
          <div class="space-y-2 text-lg text-white">
            <div class="flex justify-between max-w-xs mx-auto sm:mx-0">
              <span>Pondělí - Pátek</span>
              <span class="font-semibold">8:00 - 16:00</span>
            </div>
            <div class="flex justify-between max-w-xs mx-auto sm:mx-0">
              <span>Sobota</span>
              <span class="font-semibold">8:00 - 12:00</span>
            </div>
            <div class="flex justify-between max-w-xs mx-auto sm:mx-0">
              <span>Neděle</span>
              <span class="text-cream/70">po tel. domluvě</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
